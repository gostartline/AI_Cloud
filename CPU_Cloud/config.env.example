# STARTLINE CPU Cloud non-GPU prevalidation baseline.
# Copy to config.env before running on a VM. The default model checksum is pinned
# to the current ggml-org Gemma 4 E2B Q4_0 artifact and is verified on download.

BASELINE_VERSION=cpu-prevalidation-v1.2
TARGET_CPU_VCPU=4
TARGET_MEMORY_GIB=16
TARGET_LOCAL_STORAGE_GIB=240
TARGET_CPU_CLASS="Dedicated CPU"
TARGET_REGION=Tokyo
TARGET_HOURLY_USD=0.153
MIN_ROOT_DISK_GIB=100
SUPPORTED_UBUNTU_VERSIONS="22.04 24.04"

KUBERNETES_VERSION=1.35.6
KUBERNETES_MINOR=1.35
CONTAINERD_VERSION=2.2.6
RUNC_VERSION=1.5.1
CNI_PLUGINS_VERSION=1.9.1
FLANNEL_VERSION=0.27.4
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12

CPU_NODE_NAME=
KUBE_API_ADDRESS=

LLM_NAMESPACE=startline-ai
LLM_SERVICE=gemma4-e2b
LLM_PORT=8080
LLM_CONTEXT=4096
LLM_THREADS=3
LLM_PARALLEL=1
LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b10666
MODEL_ID=google/gemma-4-E2B-it
MODEL_GGUF_REPO=ggml-org/gemma-4-E2B-it-GGUF
MODEL_FILE=gemma-4-E2B-it-Q4_0.gguf
MODEL_URL=https://huggingface.co/ggml-org/gemma-4-E2B-it-GGUF/resolve/main/gemma-4-E2B-it-Q4_0.gguf?download=true
MODEL_DIR=/var/lib/startline-cpu-cloud/models/gemma-4-e2b
MODEL_PATH=/var/lib/startline-cpu-cloud/models/gemma-4-e2b/gemma-4-E2B-it-Q4_0.gguf
MODEL_SHA256=8e30dff3ac4c8434c49a7036fa15564bdbb6044e42bf04550bf1a096ad7e6a52

PROMETHEUS_NAMESPACE=startline-monitoring
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
GRAFANA_IMAGE=grafana/grafana:13.1.4-slim

STARTLINE_LOG_DIR=/var/log/startline-cpu-cloud
STARTLINE_STATE_DIR=/var/lib/startline-cpu-cloud
EVIDENCE_ROOT=/var/lib/startline-cpu-cloud/evidence

# No password, token, kubeconfig, or model access credential belongs here.
# If Hugging Face authentication is required, use the host credential store or
# an ephemeral environment variable and never write it to Evidence.
